    FRICTIONLESS, fraction=1, maximumElasticSlip=FRACTION, table=((0.1, ), ))
mdb.models['ModeloRiser'].ContactProperty('ContatoShell')
mdb.models['ModeloRiser'].interactionProperties['ContatoShell'].NormalBehavior(
    allowSeparation=ON, pressureOverclosure=HARD)
mdb.models['ModeloRiser'].interactionProperties['ContatoShell'].TangentialBehavior(
    formulation=FRICTIONLESS)
mdb.models['ModeloRiser'].ContactExp(contactPropertyAssignments=((GLOBAL, SELF, 
    'ContatoTension'), ), createStepName='Initial', name='GeneralContact')
mdb.models['ModeloRiser'].ExpInitialization(name='Contact_Initialization', 
    overclosureType=INTERFERENCE)
mdb.models['ModeloRiser'].ContactProperty('ContatoTension')
mdb.models['ModeloRiser'].interactionProperties['ContatoTension'].NormalBehavior(
    allowSeparation=ON, pressureOverclosure=HARD)
mdb.models['ModeloRiser'].interactionProperties['ContatoTension'].TangentialBehavior(
    directionality=ISOTROPIC, elasticSlipStiffness=None, formulation=
    FRICTIONLESS, fraction=1, maximumElasticSlip=FRACTION, table=((0.1, ), ))
mdb.models['ModeloRiser'].ContactProperty('ContatoShell')
mdb.models['ModeloRiser'].interactionProperties['ContatoShell'].NormalBehavior(
    allowSeparation=ON, pressureOverclosure=HARD)
mdb.models['ModeloRiser'].interactionProperties['ContatoShell'].TangentialBehavior(
    formulation=FRICTIONLESS)
mdb.models['ModeloRiser'].rootAssembly.Surface(name=
    'Surf-PressureReinforcement-1', side1Faces=
    mdb.models['ModeloRiser'].rootAssembly.instances['PressureReinforcement'].faces)
mdb.models['ModeloRiser'].rootAssembly.Surface(name=
    'Surf-PressureReinforcement-2', side2Faces=
    mdb.models['ModeloRiser'].rootAssembly.instances['PressureReinforcement'].faces)
mdb.models['ModeloRiser'].rootAssembly.Surface(name='Surf-InnerArmour-1-1', 
    side1Faces=None)
#* TypeError: keyword error on side1Faces
mdb.models['ModeloRiser'].rootAssembly.Surface(name='Surf-InnerArmour-1-2', 
    side1Faces=None)
#* TypeError: keyword error on side1Faces
mdb.models['ModeloRiser'].interactions['GeneralContact'].initializationAssignments.appendInStep(
    assignments=(), stepName='Initial')
mdb.models['ModeloRiser'].interactions['GeneralContact'].deactivate(
    'Step_Explicit')
mdb.models['ModeloRiser'].ContactExp(contactPropertyAssignments=((GLOBAL, SELF, 
    'ContatoTension'), ), createStepName='Step_Explicit', name=
    'GeneralContact-2')
